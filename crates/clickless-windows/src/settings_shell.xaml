<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="24,16" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Clickless" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <AutoSuggestBox x:Name="Search" Grid.Column="1" MaxWidth="620"
                        PlaceholderText="Search settings" QueryIcon="Find"
                        AutomationProperties.Name="Search settings" />
        <ComboBox x:Name="UiTheme" Grid.Column="2" AutomationProperties.Name="App theme">
            <ComboBoxItem Content="System" />
            <ComboBoxItem Content="Light" />
            <ComboBoxItem Content="Dark" />
        </ComboBox>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed" OpenPaneLength="240"
                    CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="880"
                    PaneDisplayMode="Auto" IsPaneToggleButtonVisible="True">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="General" Tag="0" Icon="Setting" />
            <NavigationViewItem Content="Movement" Tag="1" Icon="Map" />
            <NavigationViewItem Content="Grid" Tag="2" Icon="ViewAll" />
            <NavigationViewItem Content="Shortcuts" Tag="3" Icon="Edit" />
            <NavigationViewItem Content="Appearance" Tag="4" Icon="Highlight" />
            <NavigationViewItem Content="About" Tag="5" Icon="Help" />
        </NavigationView.MenuItems>
        <Grid Padding="24,16,24,20" RowSpacing="16" AutomationProperties.LandmarkType="Main">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="Heading" Text="General" Style="{ThemeResource TitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1" />
            <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Cards" Spacing="8" MaxWidth="1000" />
            </ScrollViewer>
            <Grid x:Name="Actions" Grid.Row="2" />
            <InfoBar x:Name="Status" Grid.Row="3" IsOpen="True" IsClosable="False"
                     Severity="Informational"
                     Message="Apply changes this session. Save also keeps changes for next launch." />
        </Grid>
    </NavigationView>
</Grid>
